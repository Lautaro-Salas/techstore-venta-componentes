// =============================================================
//  TechStore AR — modelo de datos
//  Montos en pesos argentinos (ARS) como enteros (sin centavos).
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
//  Usuarios, roles y permisos (RBAC)
// ---------------------------------------------------------------

enum DocumentType {
  DNI
  CUIT
  CUIL
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // CUSTOMER | STAFF | ADMIN | SUPER_ADMIN
  description String?
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // ej: "products:write"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  documentType    DocumentType?
  documentNumber  String?
  emailVerifiedAt DateTime?
  isActive        Boolean       @default(true)
  marketingOptIn  Boolean       @default(false)
  roleId          String
  role            Role          @relation(fields: [roleId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sessions           Session[]
  authTokens         AuthToken[]
  addresses          Address[]
  orders             Order[]
  cart               Cart?
  wishlist           Wishlist?
  reviews            Review[]
  notifications      Notification[]
  couponRedemptions  CouponRedemption[]
  inventoryMovements InventoryMovement[]
  orderStatusChanges OrderStatusHistory[]
  auditLogs          AuditLog[]

  @@index([roleId])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  type      AuthTokenType
  tokenHash String        @unique
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String? // "Casa", "Trabajo"
  recipientName String
  phone         String
  street        String
  number        String
  floor         String?
  apartment     String?
  city          String
  province      String
  postalCode    String
  notes         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------
//  Catálogo
// ---------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String? // nombre de ícono lucide
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  coupons     Coupon[]
  promotions  Promotion[]

  @@index([parentId, sortOrder])
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  logoUrl  String?
  products Product[]
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  sku              String        @unique
  shortDescription String?
  description      String
  price            Int
  compareAtPrice   Int?
  cost             Int?
  weightGrams      Int?
  lengthMm         Int?
  widthMm          Int?
  heightMm         Int?
  warrantyMonths   Int           @default(12)
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  tags             Json? // array de strings: ["gaming", "am5"]
  ratingAvg        Float         @default(0)
  ratingCount      Int           @default(0)
  soldCount        Int           @default(0)
  /// Desnormalizado: suma de (quantity - reserved) de todos los depósitos. Lo mantiene inventory.service.
  availableStock   Int           @default(0)
  brandId          String
  brand            Brand         @relation(fields: [brandId], references: [id])
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  images             ProductImage[]
  variants           ProductVariant[]
  specifications     ProductSpecification[]
  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  wishlistItems      WishlistItem[]
  reviews            Review[]
  coupons            Coupon[]
  promotions         Promotion[]

  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([status, price])
  @@index([status, createdAt])
  @@index([status, soldCount])
  @@index([status, availableStock])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String  @unique
  name       String // ej: "Color: Negro"
  attributes Json // { "color": "Negro" }
  price      Int? // null = hereda del producto
  isActive   Boolean @default(true)

  @@index([productId])
}

model ProductSpecification {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  group      String  @default("General")
  key        String // clave técnica estable: "socket", "memory_type"
  label      String // texto visible: "Socket"
  value      String
  filterable Boolean @default(false)
  sortOrder  Int     @default(0)

  @@unique([productId, key])
  @@index([key, value])
}

// ---------------------------------------------------------------
//  Inventario (preparado para múltiples depósitos)
// ---------------------------------------------------------------

enum InventoryMovementType {
  PURCHASE
  SALE
  RESERVATION
  RELEASE
  ADJUSTMENT
  RETURN
}

model Warehouse {
  id        String              @id @default(cuid())
  code      String              @unique
  name      String
  isDefault Boolean             @default(false)
  inventory Inventory[]
  movements InventoryMovement[]
}

model Inventory {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Int       @default(0) // stock físico
  reserved    Int       @default(0) // comprometido en pedidos pendientes
  minStock    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model InventoryMovement {
  id          String                @id @default(cuid())
  productId   String
  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  type        InventoryMovementType
  quantity    Int // positivo o negativo según el tipo
  reason      String?
  orderId     String?
  order       Order?                @relation(fields: [orderId], references: [id])
  userId      String?
  user        User?                 @relation(fields: [userId], references: [id])
  createdAt   DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
}

// ---------------------------------------------------------------
//  Carrito y favoritos
// ---------------------------------------------------------------

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponCode String?
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([updatedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

// ---------------------------------------------------------------
//  Pedidos, pagos y envíos
// ---------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InvoiceType {
  CONSUMIDOR_FINAL
  FACTURA_A
}

model Order {
  id                 String       @id @default(cuid())
  number             Int          @unique // correlativo generado en código (SQLite no admite autoincrement fuera de la PK)
  userId             String?
  user               User?        @relation(fields: [userId], references: [id])
  email              String
  firstName          String
  lastName           String
  phone              String
  documentType       DocumentType
  documentNumber     String
  invoiceType        InvoiceType  @default(CONSUMIDOR_FINAL)
  businessName       String? // razón social (Factura A)
  status             OrderStatus  @default(PENDING)
  shippingAddress    Json? // snapshot; null si es retiro en local
  shippingMethodCode String
  shippingMethodName String
  paymentMethodCode  String
  paymentMethodName  String
  subtotal           Int
  discountTotal      Int          @default(0)
  shippingTotal      Int          @default(0)
  total              Int
  couponCode         String?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  items              OrderItem[]
  payments           Payment[]
  shipment           Shipment?
  history            OrderStatusHistory[]
  inventoryMovements InventoryMovement[]
  couponRedemptions  CouponRedemption[]
  reviews            Review[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([email])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  unitPrice   Int
  quantity    Int
  total       Int

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider     String // "bank_transfer" | "mercadopago" | ...
  status       PaymentStatus @default(PENDING)
  amount       Int
  installments Int           @default(1)
  externalId   String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([orderId])
  @@index([provider, externalId])
}

enum ShipmentStatus {
  PENDING
  READY
  SHIPPED
  DELIVERED
  RETURNED
}

model Shipment {
  id           String         @id @default(cuid())
  orderId      String         @unique
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  methodCode   String
  carrier      String?
  trackingCode String?
  status       ShipmentStatus @default(PENDING)
  cost         Int
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

enum ShippingType {
  HOME_DELIVERY
  PICKUP
}

model ShippingMethod {
  id               String       @id @default(cuid())
  code             String       @unique
  name             String
  description      String?
  type             ShippingType
  provider         String       @default("flat") // "flat" | "pickup" | "andreani" | ...
  price            Int
  freeThreshold    Int? // subtotal desde el cual es gratis
  estimatedDaysMin Int          @default(1)
  estimatedDaysMax Int          @default(5)
  isActive         Boolean      @default(true)
  sortOrder        Int          @default(0)
}

model PaymentMethod {
  id              String  @id @default(cuid())
  code            String  @unique // "bank_transfer" | "mercadopago" | "cash_pickup"
  name            String
  description     String?
  discountPercent Int     @default(0)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)
}

model InstallmentPlan {
  id                String  @id @default(cuid())
  installments      Int     @unique
  interestRateBps   Int     @default(0) // 0 = sin interés; 1500 = 15%
  isActive          Boolean @default(true)
}

// ---------------------------------------------------------------
//  Reviews
// ---------------------------------------------------------------

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating    Int
  title     String?
  comment   String
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
}

// ---------------------------------------------------------------
//  Descuentos
// ---------------------------------------------------------------

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id              String             @id @default(cuid())
  code            String             @unique
  description     String?
  type            DiscountType
  value           Int // % (1-100) o monto fijo en ARS
  startsAt        DateTime?
  endsAt          DateTime?
  minSubtotal     Int?
  maxUses         Int?
  maxUsesPerUser  Int?
  usedCount       Int                @default(0)
  isActive        Boolean            @default(true)
  categories      Category[]
  products        Product[]
  redemptions     CouponRedemption[]
  createdAt       DateTime           @default(now())
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  createdAt DateTime @default(now())

  @@index([couponId, userId])
  @@index([couponId, email])
}

// Promoción automática (sin código): se aplica sola si se cumplen las condiciones.
model Promotion {
  id          String       @id @default(cuid())
  name        String
  description String?
  type        DiscountType
  value       Int
  startsAt    DateTime?
  endsAt      DateTime?
  minSubtotal Int?
  isActive    Boolean      @default(true)
  categories  Category[]
  products    Product[]
  createdAt   DateTime     @default(now())
}

// ---------------------------------------------------------------
//  Notificaciones, contacto y configuración
// ---------------------------------------------------------------

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id        String             @id @default(cuid())
  userId    String?
  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String
  channel   String // "email" | "whatsapp"
  recipient String
  subject   String?
  payload   Json
  status    NotificationStatus @default(PENDING)
  error     String?
  createdAt DateTime           @default(now())
  sentAt    DateTime?

  @@index([event, createdAt])
  @@index([status])
}

enum ContactReason {
  GENERAL
  ORDER
  WARRANTY
  PRODUCT
  RETURN
  TECHNICAL
  OTHER
}

enum ContactStatus {
  NEW
  READ
  ANSWERED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  reason    ContactReason
  message   String
  status    ContactStatus @default(NEW)
  ip        String?
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------
//  Auditoría del panel (quién hizo qué, cuándo)
// ---------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  action    String // PRODUCT_CREATE, STOCK_ADJUST, ORDER_STATUS, ...
  entity    String // "product" | "order" | "inventory" | ...
  entityId  String?
  detail    String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}
